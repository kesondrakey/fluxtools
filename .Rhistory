source("E:/Github/Ameriflux_Processing/US-VT1/Step4_editing.R", echo = TRUE)
library(dplyr)
library(tidyr)
library(ggplot2)
library(readr); library(dplyr); library(tidyr); library(ggplot2)
raw_path      <- "E:/Github/Ameriflux_Processing/US-VT1/data/US-VT1_Step3.csv"
filtered_path <- "E:/Github/Ameriflux_Processing/US-VT1/data/US-VT1_Step3_After_Fluxtools_readr.csv"
out_pdf       <- "E:/Github/Ameriflux_Processing/US-VT1/Results/QAQC_Results/Comparison_Raw_vs_Filtered_v2.pdf"
NA_STRINGS <- c("NA","NaN","","-9999","-9999.0","-9999.00","-9999.000")
# ---- read fresh with the same NA policy, keep TIMESTAMP_START as char -----
raw      <- read_csv(raw_path,      na = NA_STRINGS, col_types = cols(TIMESTAMP_START = col_character()))
filtered <- read_csv(filtered_path, na = NA_STRINGS, col_types = cols(TIMESTAMP_START = col_character()))
# ---- choose variables (numeric and present in both) -----------------------
num_vars <- intersect(names(select(raw, where(is.numeric))),
names(select(filtered, where(is.numeric))))
# ---- human-equality digits per var (tweakable) ----------------------------
digits_map <- setNames(rep(3L, length(num_vars)), num_vars)           # default 3 dp
digits_map[grepl("^(TA_|T_SONIC_)", names(digits_map))] <- 2L         # temps 2 dp
digits_map[grepl("^SWC_", names(digits_map))] <- 3L                   # SWC 3 dp
digits_map[grepl("^(PPFD|SW_(IN|OUT)|LW_(IN|OUT)|NETRAD)", names(digits_map))] <- 1L
digits_map[grepl("^(FC|LE|H|G)_", names(digits_map))] <- 2L           # fluxes 2 dp
digits_map[grepl("^P_1_1_1$", names(digits_map))] <- 1L               # pressure 1 dp
digits_map[grepl("^(RH|WS(_MAX)?|WD|USTAR|U_SIGMA|V_SIGMA|W_SIGMA|VPD|PA|MO_LENGTH|ZL)_",
names(digits_map))] <- 2L
# helper: format to d decimals AND normalize negative zero
fmt_num <- function(x, d) {
out <- sprintf(paste0("%.", d, "f"), x)
out[is.na(x)] <- NA_character_
# turn "-0.00" into "0.00" (for any dp)
out <- sub("^-0(\\.0+)$", "0\\1", out, perl = TRUE)
out
}
# ---- long join by the exact string timestamp only (safer) -----------------
long_raw <- raw %>% select(TIMESTAMP_START, any_of(num_vars)) %>%
pivot_longer(-TIMESTAMP_START, names_to="var", values_to="raw")
long_fil <- filtered %>% select(TIMESTAMP_START, any_of(num_vars)) %>%
pivot_longer(-TIMESTAMP_START, names_to="var", values_to="filt")
# lookup table for digits (avoids grouped indexing pitfalls)
lut <- tibble(var = names(digits_map), d = unname(digits_map))
comp <- comp %>%
group_by(var) %>%
mutate(
# size of 1 ulp at chosen precision
unit = 10^(-d),
both_num = !is.na(raw) & !is.na(filt),
delta = if_else(both_num, filt - raw, NA_real_),
# 1) edge flips: print differs but underlying delta < 0.5 * unit
edge_flip = both_num & raw_s != filt_s & abs(delta) < 0.5*unit + 1e-12,
# 2) “real” value↔value: underlying delta at least one full ulp
real_valval = both_num & abs(delta) >= unit - 1e-12,
# 3) final class (what to color)
class = dplyr::case_when(
xor(is.na(raw), is.na(filt)) ~ "value↔NA",
real_valval                 ~ "value↔value",
edge_flip                   ~ "rounding-edge",
TRUE                        ~ "same"
),
changed_real = class %in% c("value↔NA","value↔value")
) %>%
ungroup()
source("E:/Github/Ameriflux_Processing/US-VT1/Step4_editing.R", echo = TRUE)
runApp('inst/app')
